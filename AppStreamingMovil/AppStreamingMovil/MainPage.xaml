<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppStreamingMovil.MainPage"
             Title="Cine Movil">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#08131F" Offset="0.0" />
            <GradientStop Color="#0E1E2F" Offset="0.45" />
            <GradientStop Color="#132A3F" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="#2BFFFFFF" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#70000000" Opacity="0.7" Radius="16" Offset="0,8" />
                </Setter.Value>
            </Setter>
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="18" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="PlaceholderColor" Value="#90B5C7D6" />
            <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#14B8A6" />
            <Setter Property="TextColor" Value="#062A28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1AFFFFFF" />
            <Setter Property="TextColor" Value="#D8F6F2" />
            <Setter Property="BorderColor" Value="#46FFFFFF" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Grid.InputTransparent>False</Grid.InputTransparent>

        <Border Background="#1AFF8A65"
                StrokeThickness="0"
                WidthRequest="180"
                HeightRequest="180"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                TranslationX="-55"
                TranslationY="30">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="90" />
            </Border.StrokeShape>
        </Border>

        <Border Background="#1A22D3EE"
                StrokeThickness="0"
                WidthRequest="220"
                HeightRequest="220"
                HorizontalOptions="End"
                VerticalOptions="Center"
                TranslationX="70"
                TranslationY="-140">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="110" />
            </Border.StrokeShape>
        </Border>

        <ScrollView>
            <VerticalStackLayout Padding="20,18,20,28" Spacing="16">
                <Border x:Name="loginSection" Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Iniciar sesion"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Correo" TextColor="#DCEAF0" FontSize="13" />
                            <Entry x:Name="correoCliente"
                                   Style="{StaticResource InputStyle}"
                                   Placeholder="correo@dominio.com"
                                   Keyboard="Email" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Contrasena" TextColor="#DCEAF0" FontSize="13" />
                            <Entry x:Name="contrasenaCliente"
                                   Style="{StaticResource InputStyle}"
                                   Placeholder="Ingresa tu contrasena"
                                   IsPassword="True" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <CheckBox x:Name="mostrarContrasena" CheckedChanged="ShowPasswordChanged" Color="#14B8A6" />
                            <Label Text="Mostrar contrasena" VerticalOptions="Center" TextColor="#C7DEE8" />
                        </HorizontalStackLayout>

                        <Button x:Name="iniciarSesion"
                                Text="Entrar al catalogo"
                                Clicked="Sesion"
                                Style="{StaticResource PrimaryButtonStyle}" />

                        <Button x:Name="registrarseButton"
                                Text="No tienes cuenta? Registrarse"
                                Clicked="RegistrarseClicked"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Grid x:Name="loadingIndicatorContainer" IsVisible="False">
                    <Border Style="{StaticResource CardBorderStyle}" Background="#1EFFFFFF" Padding="12">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <ActivityIndicator x:Name="loadingIndicator"
                                               IsVisible="False"
                                               IsRunning="False"
                                               Color="#14B8A6" />
                            <Label Text="Cargando..." TextColor="#D9ECF4" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout x:Name="catalogSection" IsVisible="False" Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Actualizar"
                                Clicked="CargarCatalogoClicked"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="1"
                                Text="Cerrar sesion"
                                Clicked="CerrarSesionClicked"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <CollectionView x:Name="moviesCollectionView"
                                    SelectionMode="None"
                                    EmptyView="No hay peliculas activas para mostrar.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                    <VerticalStackLayout Spacing="10">
                                        <Border Stroke="#22FFFFFF" StrokeThickness="1" Padding="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ImageUrl}"
                                                   HeightRequest="190"
                                                   Aspect="AspectFill"
                                                   BackgroundColor="#0B1620" />
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="19"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   LineBreakMode="TailTruncation" />
                                            <Border Grid.Column="1"
                                                    Background="#1838BDF8"
                                                    Stroke="#2A60A5FA"
                                                    Padding="8,4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Genre}" TextColor="#B8DEFF" FontSize="11" FontAttributes="Bold" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding Description}"
                                               TextColor="#D3E5EE"
                                               FontSize="13"
                                               LineBreakMode="WordWrap" />

                                        <Button Text="Ver trailer"
                                                Clicked="TrailerClicked"
                                                CommandParameter="{Binding TrailerUrl}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
