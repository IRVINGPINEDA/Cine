# cp .env.example .env

ASPNETCORE_ENVIRONMENT=Production

DOMAIN=caleiro.online
ACME_EMAIL=tu-correo@tudominio.com

POSTGRES_DB=cine_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_POSTGRES

JWT_ISSUER=Cine.Web
