@model IEnumerable<Cine.Web.Models.Movie>
@{
    ViewData["Title"] = "Consulta de Peliculas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Consulta de Peliculas</h2>
    <a asp-action="Create" class="btn btn-success">Registrar Pelicula</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Genero</th>
                <th>Estado</th>
                <th>Creada</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Id</td>
                    <td>@movie.Name</td>
                    <td>@movie.Genre</td>
                    <td>
                        @if (movie.IsActive)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactiva</span>
                        }
                    </td>
                    <td>@movie.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-primary">Modificar</a>
                            @if (movie.IsActive)
                            {
                                <form asp-action="Inactivate" asp-route-id="@movie.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-warning">Inactivar</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Activate" asp-route-id="@movie.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-success">Activar</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

