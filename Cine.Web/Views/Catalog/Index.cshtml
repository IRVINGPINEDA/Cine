@model IEnumerable<Cine.Web.Models.Movie>
@{
    ViewData["Title"] = "Catalogo";
}

<h2 class="mb-4">Catalogo de Peliculas</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay peliculas activas disponibles.</div>
}
else
{
    <div class="row g-4">
        @foreach (var movie in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(movie.ImagePath))
                    {
                        <img src="@movie.ImagePath" class="card-img-top" alt="@movie.Name" style="height:220px; object-fit:cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@movie.Name</h5>
                        <p class="text-muted mb-2">@movie.Genre</p>
                        <p class="card-text">@movie.Description</p>
                        <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-primary mt-auto">Ver</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

