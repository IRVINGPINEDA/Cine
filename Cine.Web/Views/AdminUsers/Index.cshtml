@model IEnumerable<Cine.Web.Models.ViewModels.AdminUserListItemViewModel>
@{
    ViewData["Title"] = "Registro de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Registro de Usuarios</h2>
    <a asp-action="Create" class="btn btn-success">Nuevo Usuario</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Creado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Actualizar</a>
                            <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post">
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")">
                                    @(user.IsActive ? "Inactivar" : "Activar")
                                </button>
                            </form>
                            <form asp-action="ResetPassword" asp-route-id="@user.Id" method="post" onsubmit="return confirm('¿Regenerar contraseña temporal para este usuario?');">
                                <button type="submit" class="btn btn-sm btn-secondary">Resetear contraseña</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('?Eliminar usuario?');">
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

