@model IEnumerable<Cine.Web.Models.Client>
@{
    ViewData["Title"] = "Registro de Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Registro de Clientes</h2>
    <a asp-action="Create" class="btn btn-success">Nuevo Cliente</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre completo</th>
                <th>Email</th>
                <th>Fecha registro</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.FullName</td>
                    <td>@client.Email</td>
                    <td>@client.RegisteredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (client.IsActive)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-primary">Editar</a>
                            <form asp-action="ToggleActive" asp-route-id="@client.Id" method="post">
                                <button type="submit" class="btn btn-sm @(client.IsActive ? "btn-warning" : "btn-success")">
                                    @(client.IsActive ? "Inactivar" : "Activar")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
